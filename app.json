{
  "expo": {
    "name": "APK Fact",
    "slug": "apk-fact",
    "owner": "aqadas-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0B0F1A",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.yourname.apkfact",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "REQUEST_INSTALL_PACKAGES"
      ],
      "navigationBar": {
        "backgroundColor": "#141A29",
        "barStyle": "light-content"
      }
    },
    "ios": {
      "bundleIdentifier": "com.yourname.apkfact"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "10c32177-1c65-4a2b-8e55-1c4bc5cd8d7d"
      }
    },
    "backgroundColor": "#0B0F1A"
  }
}
