{
  "expo": {
    "name": "App Factory",
    "slug": "app-factor",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#111111",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.yourname.appfactory",
      "permissions": ["INTERNET", "ACCESS_NETWORK_STATE"]
    },
    "ios": {
      "bundleIdentifier": "com.yourname.appfactory"
    },
    "plugins": ["expo-secure-store"],
    "extra": {
      "eas": {
        "projectId": "2014ad46-c059-40c7-8f21-439f90c4d7d2"
      }
    }
  }
}
